{
  "name": "kimi-swarm-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "author": "ximenchuifeng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanameier/kimi-swarm-bridge.git"
  },
  "homepage": "https://github.com/ryanameier/kimi-swarm-bridge#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "kimi-swarm-bridge": "dist/index.js",
    "codex-kimi-bridge": "dist/index.js"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:plugin": "esbuild src/plugin-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugins/kimi-delegate/mcp/server.mjs",
    "build": "pnpm build:core && pnpm build:plugin",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "description": "MCP bridge for Kimi Code native AgentSwarm with inference through ai&.",
  "bugs": {
    "url": "https://github.com/ryanameier/kimi-swarm-bridge/issues"
  }
}
